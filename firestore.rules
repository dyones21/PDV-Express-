rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Regra Global Catch-All de Segurança (Default Deny)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Funções auxiliares de autenticação e controle de acesso multi-tenant
    function isAuthenticated() {
      return request.auth != null;
    }

    // Identifica Administrador da Plataforma (registrado na coleção platformAdmins)
    function isPlatformAdmin() {
      return isAuthenticated() && exists(/databases/$(database)/documents/platformAdmins/$(request.auth.uid));
    }

    // Verifica se o usuário autenticado possui registro de negócio associado
    function hasBusinessMap() {
      return isAuthenticated() && exists(/databases/$(database)/documents/userBusinessMap/$(request.auth.uid));
    }

    // Retorna o businessId mapeado para o usuário atual
    function getUserBusinessId() {
      return get(/databases/$(database)/documents/userBusinessMap/$(request.auth.uid)).data.businessId;
    }

    // Valida se o usuário autenticado é o proprietário do negócio solicitado (via userBusinessMap ou ownerUid no documento do negócio)
    function isOwnerOfBusiness(businessId) {
      return isAuthenticated() && (
        (hasBusinessMap() && getUserBusinessId() == businessId) ||
        (exists(/databases/$(database)/documents/businesses/$(businessId)) &&
         get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerUid == request.auth.uid)
      );
    }

    // 3. Coleção: platformAdmins
    // Apenas administradores da plataforma podem ler ou gerenciar outros administradores
    match /platformAdmins/{uid} {
      allow read: if isAuthenticated() && (request.auth.uid == uid || isPlatformAdmin());
      allow write: if isPlatformAdmin();
    }

    // 4. Coleção: userBusinessMap
    // Mapeamento essencial entre UID do Firebase Auth e o ID da empresa do MEI
    match /userBusinessMap/{uid} {
      // O próprio usuário ou o administrador podem ler o mapeamento
      allow read: if isAuthenticated() && (request.auth.uid == uid || isPlatformAdmin());

      // O próprio usuário pode criar seu mapeamento inicial, impedindo vinculação a negócio pré-existente
      allow create: if isAuthenticated() && request.auth.uid == uid &&
        request.resource.data.businessId is string &&
        request.resource.data.businessId.size() > 0 &&
        !exists(/databases/$(database)/documents/businesses/$(request.resource.data.businessId));

      // O usuário pode atualizar o nome do negócio ou metadados,
      // mas é terminantemente proibido de alterar o businessId para outro ID
      allow update: if isAuthenticated() && (
        isPlatformAdmin() || (
          request.auth.uid == uid &&
          request.resource.data.businessId == resource.data.businessId
        )
      );

      // Exclusão permitida para administradores ou pelo próprio usuário (ex: rollback de cadastro incompleto)
      allow delete: if isAuthenticated() && (isPlatformAdmin() || request.auth.uid == uid);
    }

    // 5. Coleção Raiz: businesses (Multi-tenant)
    match /businesses/{businessId} {
      // Leitura permitida para o admin da plataforma ou para o dono do negócio
      allow read: if isPlatformAdmin() || 
        isOwnerOfBusiness(businessId) || 
        (isAuthenticated() && resource.data.ownerUid == request.auth.uid);

      // Criação permitida para admin da plataforma ou para o usuário criando sua nova empresa (obrigatoriamente inativa, aguardando aprovação do admin)
      allow create: if isAuthenticated() && (
        isPlatformAdmin() || (
          request.resource.data.active == false &&
          (
            (request.resource.data.ownerUid != null && request.resource.data.ownerUid == request.auth.uid) ||
            (request.resource.data.ownerEmail != null && request.auth.token.email != null && request.resource.data.ownerEmail.lower() == request.auth.token.email.lower())
          )
        )
      );

      // Atualização: Admin ou dono do negócio (dono não pode alterar o status active)
      allow update: if isPlatformAdmin() || (
        (isOwnerOfBusiness(businessId) || (isAuthenticated() && resource.data.ownerUid == request.auth.uid)) &&
        request.resource.data.active == resource.data.active
      );

      // Exclusão: Restrito exclusivamente a Administradores da plataforma
      allow delete: if isPlatformAdmin();

      // 5.1 Subcoleção: sellers (Vendedores com PIN de segurança)
      match /sellers/{sellerId} {
        allow read, write: if isPlatformAdmin() || isOwnerOfBusiness(businessId);
      }

      // 5.2 Subcoleção: customers (Clientes da rota)
      match /customers/{customerId} {
        allow read, write: if isPlatformAdmin() || isOwnerOfBusiness(businessId);
      }

      // 5.3 Subcoleção: products (Catálogo e controle de estoque)
      match /products/{productId} {
        allow read, write: if isPlatformAdmin() || isOwnerOfBusiness(businessId);
      }

      // 5.4 Subcoleção: sales (Vendas à vista e fiado)
      match /sales/{saleId} {
        allow read, write: if isPlatformAdmin() || isOwnerOfBusiness(businessId);
      }

      // 5.5 Subcoleção: payments (Recebimentos e abatimentos de fiado)
      match /payments/{paymentId} {
        allow read, write: if isPlatformAdmin() || isOwnerOfBusiness(businessId);
      }

      // 5.6 Subcoleção: priceTables (Tabelas de preço por cliente)
      match /priceTables/{priceTableId} {
        allow read, write: if isPlatformAdmin() || isOwnerOfBusiness(businessId);
      }

      // 5.7 Subcoleção: notices (Avisos e comunicados do administrador)
      match /notices/{noticeId} {
        allow read: if isPlatformAdmin() || isOwnerOfBusiness(businessId);
        allow create: if isPlatformAdmin();
        allow update: if isPlatformAdmin() || (
          isOwnerOfBusiness(businessId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        );
        allow delete: if isPlatformAdmin();
      }
    }

    // 6. Coleção Raiz: publicCatalog (Catálogo Virtual Público - Vitrine de Produtos)
    // Leitura irrestrita para qualquer visitante sem login; escrita restrita ao dono do negócio ou admin
    match /publicCatalog/{businessId} {
      allow read: if true;
      allow write: if isPlatformAdmin() || isOwnerOfBusiness(businessId);
      match /items/{productId} {
        allow read: if true;
        allow write: if isPlatformAdmin() || isOwnerOfBusiness(businessId);
      }
    }
  }
}

